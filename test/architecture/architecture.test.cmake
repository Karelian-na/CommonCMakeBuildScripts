cmake_minimum_required(VERSION 3.17.1)
include("${CMAKE_CURRENT_LIST_DIR}/../../common.cmake")

# Simulate compiler metadata without loading libkrt or any external environment.
set(CMAKE_CXX_PLATFORM_ID Linux)
set(CMAKE_CXX_COMPILER_ID GNU)
set(CMAKE_C_COMPILER_ARCHITECTURE_ID "")
set(CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES "")
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SIZEOF_VOID_P 8)
set(CMAKE_BUILD_TYPE Debug)
unset(TARGET_ARCH)
unset(OUTPUT_DIR)

if(TEST_CASE STREQUAL "auto-x86-debug")
    set(CMAKE_SIZEOF_VOID_P 4)
    set(expectedArchitecture x86)
    set(expectedOutput x86_GNUD)
elseif(TEST_CASE STREQUAL "auto-x64-debug")
    set(expectedArchitecture x64)
    set(expectedOutput x64_GNUD)
elseif(TEST_CASE STREQUAL "auto-x86-release")
    set(CMAKE_SYSTEM_PROCESSOR i686)
    set(CMAKE_SIZEOF_VOID_P 4)
    set(CMAKE_BUILD_TYPE RelWithDebInfo)
    set(expectedArchitecture x86)
    set(expectedOutput x86_GNUR)
elseif(TEST_CASE STREQUAL "auto-x64-release")
    set(CMAKE_BUILD_TYPE RelWithDebInfo)
    set(expectedArchitecture x64)
    set(expectedOutput x64_GNUR)
elseif(TEST_CASE STREQUAL "auto-arm64")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(expectedArchitecture arm64)
    set(expectedOutput arm64_GNUD)
elseif(TEST_CASE STREQUAL "requested-x86")
    set(TARGET_ARCH x86)
    set(CMAKE_SIZEOF_VOID_P 4)
    set(expectedArchitecture x86)
    set(expectedOutput x86_GNUD)
elseif(TEST_CASE STREQUAL "requested-x64")
    set(TARGET_ARCH x64)
    set(expectedArchitecture x64)
    set(expectedOutput x64_GNUD)
elseif(TEST_CASE STREQUAL "mismatch-x86")
    set(TARGET_ARCH x86)
elseif(TEST_CASE STREQUAL "mismatch-x64")
    set(TARGET_ARCH x64)
    set(CMAKE_SIZEOF_VOID_P 4)
elseif(TEST_CASE STREQUAL "invalid-request")
    set(TARGET_ARCH unknown)
elseif(TEST_CASE STREQUAL "missing-abi")
    set(TARGET_ARCH x86)
    unset(CMAKE_SIZEOF_VOID_P)
else()
    message(FATAL_ERROR "Unknown architecture test case: ${TEST_CASE}")
endif()

PrepareProject()
if(NOT DEFINED expectedArchitecture)
    message(FATAL_ERROR "Unexpectedly accepted ${TEST_CASE}: OUTPUT_DIR=${OUTPUT_DIR}")
endif()
if(NOT TARGET_ARCH STREQUAL expectedArchitecture OR NOT OUTPUT_DIR STREQUAL expectedOutput)
    message(FATAL_ERROR "Expected ${expectedArchitecture}/${expectedOutput}, got ${TARGET_ARCH}/${OUTPUT_DIR}")
endif()
message(STATUS "PASS ${TEST_CASE}: ${TARGET_ARCH}/${OUTPUT_DIR}")